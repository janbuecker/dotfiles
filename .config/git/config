[alias]
	amend = "commit --amend --reuse-message=HEAD"
	rs = "restore --staged"

[fetch]
	prune = true

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "simple"

[user]
	email = "j.buecker@shopware.com"
	name = "Jan Bücker"

# Commit signing and the github ssh rewrite. The path is relative to this file,
# so on a server, where config.work is never checked out, the include simply
# finds nothing and git ignores it.
[include]
	path = config.work
