[alias]
	amend = "commit --amend --reuse-message=HEAD"
	rs = "restore --staged"

[commit]
	gpgSign = true
	template = "~/.config/git/commit"

[fetch]
	prune = true

[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = "~/.ssh/allowed_signers"
	program = "ssh-keygen"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "simple"

[tag]
	gpgSign = true

[url "git@github.com:"]
	insteadOf = "https://github.com/"

