[alias]
	amend = "commit --amend --reuse-message=HEAD"
	rs = "restore --staged"

[fetch]
	prune = true

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = "simple"

[user]
	email = "j.buecker@shopware.com"
	name = "Jan Bücker"

# Commit signing and the github ssh rewrite. Relative to this file, so it is
# simply absent on a server, where install.sh links only config and ignore.
# A missing include is ignored by git.
[include]
	path = config.full
